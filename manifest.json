{
  "manifest_version": 3,
  "name": "ShouldIApply",
  "version": "0.1.0",
  "description": "Does this job fit me? Instantly see whether a job posting matches your CV.",
  "permissions": ["storage", "activeTab", "scripting", "offscreen"],
  "host_permissions": ["https://openrouter.ai/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["popup.html", "popup.css", "popup.js", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
